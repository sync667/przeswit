# Skopiuj do data/przeswit.env (scripts/run_app.cmd wczyta te zmienne przy starcie).
# Dostęp z internetu przez Cloudflare Tunnel + Access — zobacz README, sekcja „Dostęp z telefonu”.
PRZESWIT_PUBLIC_HOST=przeswit.example.com
PRZESWIT_ACCESS_EMAILS=ty@example.com,gosc@example.com
# Właściciele (mogą zapisywać); reszta dozwolonych adresów ma tryb tylko do odczytu. Domyślnie: wszyscy z listy wyżej.
PRZESWIT_OWNER_EMAILS=ty@example.com
# Weryfikacja podpisu JWT Access (opcjonalna, zalecana): nazwa zespołu Zero Trust (https://<team>.cloudflareaccess.com) i aud aplikacji
# PRZESWIT_ACCESS_TEAM=team
# PRZESWIT_ACCESS_AUD=1a9d...
# Opcjonalnie: katalog modeli Ollamy (domyślnie ~/.ollama/models), równoległość pobierania zdjęć (1-10), inna lokalizacja danych
# PRZESWIT_MODELS=D:\Ollama
# PRZESWIT_PHOTO_PARALLEL=6
# PRZESWIT_DATA=D:\przeswit-data
